// Windows resources for whitesoft.exe: icon, version information and the
// application manifest. windres turns this into app_windows_amd64.syso, which
// go build picks up from the package directory.
//
// A program with no version resource and no icon looks anonymous to Windows and
// to security software, which is one reason a freshly built executable can draw
// a warning where a packaged one would not.
#include <winver.h>

1 ICON "app.ico"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "WhiteSoft"
      VALUE "FileDescription",  "WhiteSoft 本地白板"
      VALUE "FileVersion",      "2.0.0.0"
      VALUE "InternalName",     "whitesoft"
      VALUE "LegalCopyright",   "WhiteSoft"
      VALUE "OriginalFilename", "whitesoft.exe"
      VALUE "ProductName",      "WhiteSoft"
      VALUE "ProductVersion",   "2.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
